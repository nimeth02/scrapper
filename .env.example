# LLM. One request walks a chain of models until one answers (see app/llm):
#   every model of LLM_PROVIDER ("gemini" or "groq"): *_MODEL first, then *_FALLBACK_MODELS in order,
#   then every model of the other provider, if its API key is set.
# A model that fails with a quota / overload / timeout error is skipped for LLM_COOLDOWN_SECONDS, a
# retired model name for LLM_UNAVAILABLE_COOLDOWN_SECONDS, and a bad API key disables that provider.
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash

# Optional - only if LLM_PROVIDER=groq (also used as the cross-provider fallback when set)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# Fallback behaviour
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_RETRIES_PER_MODEL=1
LLM_COOLDOWN_SECONDS=30
LLM_UNAVAILABLE_COOLDOWN_SECONDS=600

# Optional - LangSmith tracing (https://smith.langchain.com)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=scrapper

# Instagram MCP servers (app/servers). The login server signs in with Playwright and saves the
# browser session to INSTAGRAM_SESSION_FILE; the scraper server only reads that file, so the
# credentials are needed by the login server alone.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
INSTAGRAM_SESSION_FILE=data/instagram/session.json
# Keep the login browser visible so 2FA codes / "suspicious login" checkpoints can be finished by hand.
INSTAGRAM_LOGIN_HEADLESS=false
# The scraper browser can stay hidden once a session exists.
INSTAGRAM_HEADLESS=true
INSTAGRAM_LOGIN_WAIT_SECONDS=45
INSTAGRAM_NAV_TIMEOUT_SECONDS=30
# Minimum pause between two requests to Instagram. Keep it >= 1 to avoid rate limits / account locks.
INSTAGRAM_REQUEST_DELAY_SECONDS=1.5
